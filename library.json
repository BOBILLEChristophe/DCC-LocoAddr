    }
  ],
  "license": "GPL-3.0",
  "frameworks": [
    "arduino"
  ],
  "platforms": [
    "espressif32"
  ],
  "headers": [
    "DCC-LocoAddr.h"
  ],
  "examples": [
    "examples/*/*.ino"
  ],
    "export": {
